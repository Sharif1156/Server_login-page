# Optional. Defaults work for local demo use.
PORT=3000
# Set a fixed secret if you want sessions to survive server restarts.
SESSION_SECRET=change-me-in-production
# DATA_DIR=./data
# DB_PATH=./data/nafiit-demo.sqlite

# Show the demo credentials panel on login pages (off by default).
# VITE_SHOW_DEMO=true

# Required: passwords for the three accounts (min 8 characters). Keep these private.
NAFIIT_MEMBER_PASSWORD=
NAFIIT_CR_PASSWORD=
NAFIIT_EXECUTIVE_PASSWORD=
